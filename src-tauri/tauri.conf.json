{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MapleBuilding",
  "version": "1.0.0",
  "identifier": "tw.maplebuilding.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MapleBuilding",
        "width": 1280,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "preventOverflow": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "TradChinese",
          "English"
        ]
      }
    }
  }
}
